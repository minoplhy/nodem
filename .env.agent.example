# ==============================================================================
# nodem-agent (ECH Edge Agent) - Environment Configuration
# Copy this file to .env.agent on the edge node and configure the variables below.
# ==============================================================================

# Central nodem control plane server URL (e.g. http://<server-ip>:8080 or https://nodem.example.com)
ECH_SERVER=http://127.0.0.1:8080

# Server root Ed25519 public key
# Pinned on the edge agent to cryptographically verify payload signatures from server
# before staging TLS keys or executing proxy reload triggers.
ECH_SERVER_PUBLIC_KEY=replace_with_server_public_key

# Secret authentication token generated when registering this node in nodem
# (Found in the nodem Web UI: ECH -> Nodes -> Add Node / Reveal Token)
ECH_TOKEN=replace_with_node_secret_token

# Pull transport mechanism: "https" (recommended) or "ssh"
ECH_TRANSPORT=https

# Local directory where ECH configs, PEM keys, and cluster directories are staged (default: /opt/ech)
# In multi-cluster setups, keys are written to /opt/ech/cluster_<id>/
ECH_STORAGE_DIR=/opt/ech

# Reverse proxy handler: "nginx", "caddy", "haproxy", or "hook" (default: nginx)
#   - nginx:   generates /opt/ech/ech_clusters.conf and cluster includes, tests syntax, and reloads
#   - caddy:   triggers "caddy reload"
#   - haproxy: reloads HAProxy via service manager
#   - hook:    executes custom script specified by ECH_HOOK_SCRIPT
ECH_PROXY=nginx

# Init system for proxy reload service management: "auto", "systemd", or "openrc" (default: auto)
# In "auto" mode, the agent automatically detects whether the host uses Systemd or OpenRC to reload proxy daemons.
ECH_INIT_SYSTEM=auto

# Polling frequency in seconds in daemon mode (default: 300 = 5 minutes)
ECH_INTERVAL=300

# Optional proxy reload command override.
# Overrides built-in reload logic for nginx, caddy, or haproxy.
# When running inside Docker, uncomment /var/run/docker.sock mount in docker-compose.agent.yml and use:
#   ECH_RELOAD_CMD=docker exec nginx-proxy nginx -s reload
ECH_RELOAD_CMD=

# Optional path to hook script (required if ECH_PROXY=hook)
# Executed with arguments: $1 = ech_current.pem, $2 = ech_previous.pem
# Environment variables provided: ECH_ACTION, ECH_CLUSTER_ID, ECH_CLUSTER_NAME, ECH_CURRENT_PEM,
# ECH_PREVIOUS_PEM, ECH_BASE64, ECH_VERSION, ECH_PUBLIC_NAME
ECH_HOOK_SCRIPT=

# Optional SSH pull parameters (used when ECH_TRANSPORT=ssh)
# SSH pull server port on the nodem control plane (default: 34234)
ECH_SSH_PORT=34234

# Optional path to agent SSH private key for public-key authentication
# If omitted or empty, ECH_TOKEN is used as password authentication for SSH pull
# ECH_SSH_KEY=/root/.ssh/id_ed25519
ECH_SSH_KEY=
