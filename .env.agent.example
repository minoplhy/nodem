# ==============================================================================
# nodem-agent (ECH Edge Agent) - Environment Configuration
# Copy this file to .env.agent on the edge node and configure the variables below.
# ==============================================================================

# Central nodem control plane server URL (e.g. http://<server-ip>:8080 or https://nodem.example.com)
ECH_SERVER=http://127.0.0.1:8080

# Secret token generated when registering this node in Node Monitor
ECH_TOKEN=replace_with_node_secret_token

# Pull transport mechanism: "https" (recommended) or "ssh"
ECH_TRANSPORT=https

# Reverse proxy type: "nginx", "caddy", "haproxy", or "hook"
ECH_PROXY=nginx

# Polling frequency in seconds (default: 300 = 5 minutes)
ECH_INTERVAL=300

# Proxy reload command override.
# When running with Docker, uncomment the /var/run/docker.sock mount in docker-compose.agent.yml
# and specify docker exec, e.g.:
# ECH_RELOAD_CMD=docker exec nginx-proxy nginx -s reload
ECH_RELOAD_CMD=

# Optional path to hook script (if ECH_PROXY=hook)
ECH_HOOK_SCRIPT=

# Optional SSH pull parameters (used when ECH_TRANSPORT=ssh)
ECH_SSH_PORT=34234
ECH_SSH_KEY=/root/.ssh/id_ed25519
