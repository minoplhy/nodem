# ==============================================================================
# nodem (NodeManager + ECH Manager) - Control Plane Server Environment Configuration
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# HTTP server listening port for the Web UI dashboard and REST API (default: 8080)
PORT=8080

# ECH SSH pull server ingress port for edge nodes (default: 34234, set to 0 to disable)
ECH_SSH_PORT=34234

# URL path prefix if hosting nodem behind a reverse proxy subpath (e.g. /nodem or /monitor)
# Leave as / if hosting on root domain or dedicated port.
BASE_PATH=/

# Enable verbose debug logging in stdout (true / false, default: false)
DEBUG=false

# Custom OpenSSL 3.2+ / 4.x binary path with native ECH support
# Optional; auto-detected from PATH or container fallback (/opt/openssl/bin/openssl) if omitted.
# Either OPENSSL_PATH or OPENSSL_BIN is supported.
# OPENSSL_PATH=/opt/openssl/bin/openssl
